# TapNQue Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# Paths override (Optional: defaults to data/ and assets/)
# TAPNQUE_DATA_DIR=/path/to/data
# TAPNQUE_DB_PATH=/path/to/data/kiosk.db
# TAPNQUE_AUTH_PATH=/path/to/data/admin_users.json
# TAPNQUE_ASSETS_DIR=/path/to/assets

# SMTP Email Notification Settings
TAPNQUE_SMTP_SERVER=smtp.gmail.com
TAPNQUE_SMTP_PORT=587
TAPNQUE_SENDER_EMAIL=your_department_email@gmail.com
TAPNQUE_SENDER_PASSWORD=your_google_app_password

# SMS Gateway Settings (Tier 2 - pure software SMS via Semaphore cloud API)
# NOTE: These only seed the defaults on first database creation; afterwards the
# Super Admin Settings tab is the source of truth and is edited from the GUI.
# TAPNQUE_SMS_GATEWAY_URL=https://api.semaphore.co/api/v4/messages
# TAPNQUE_SMS_ENABLED=1
# TAPNQUE_SMS_MOCK_MODE=1
# TAPNQUE_SMS_API_KEY=your_semaphore_api_key_here
# TAPNQUE_SMS_SENDER_NAME=TapNQue

# Telegram Bot & QR Notification Settings
# TAPNQUE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# TAPNQUE_TELEGRAM_BOT_USERNAME=TapNQueBot
# TAPNQUE_TELEGRAM_ENABLED=1
# TAPNQUE_TELEGRAM_MOCK_MODE=1
