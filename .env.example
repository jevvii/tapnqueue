# TapNQue Environment Configuration Template
# Telegram Bot Live Push Notification Edition (OLFU Capstone Defense)
# Copy this file to .env and adjust values for your environment

# Paths override (Optional: defaults to data/ and assets/)
# TAPNQUE_DATA_DIR=/path/to/data
# TAPNQUE_DB_PATH=/path/to/data/kiosk.db
# TAPNQUE_AUTH_PATH=/path/to/data/admin_users.json
# TAPNQUE_ASSETS_DIR=/path/to/assets

# SMTP Email Notification Settings
TAPNQUE_SMTP_SERVER=smtp.gmail.com
TAPNQUE_SMTP_PORT=587
TAPNQUE_SENDER_EMAIL=your_department_email@gmail.com
TAPNQUE_SENDER_PASSWORD=your_google_app_password

# Telegram Bot & QR Notification Settings (Pre-configured Live Bot)
TAPNQUE_TELEGRAM_BOT_TOKEN=8699737243:AAEJMe5IUcf4Wj89iI2or-pcvxpxyxOG5x0
TAPNQUE_TELEGRAM_BOT_USERNAME=OlfuTapNQue_bot
TAPNQUE_TELEGRAM_ENABLED=1
TAPNQUE_TELEGRAM_MOCK_MODE=0

# Network & SSL Settings (Optional)
# Set to 0 if running behind campus or antivirus SSL inspection proxies (e.g. OLFU Wi-Fi)
# TapNQue also auto-detects and gracefully falls back if self-signed proxy inspection is detected.
TAPNQUE_SSL_VERIFY=1
